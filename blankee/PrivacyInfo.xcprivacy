<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No tracking, no analytics, no third-party SDKs. The app talks to the
	     server the person entered and, for push, to the relay - which is told
	     a device token and a notification id and nothing else. Nothing here
	     meets Apple's definition of collected data: the push token is exempt
	     when used only to deliver pushes. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- The one required-reason API in use: user defaults, both the app's own
	     (the server address, the device token) and the app group's, which the
	     widgets and the notification extension read (CA92.1 own app, 1C8F.1
	     the shared group). -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
